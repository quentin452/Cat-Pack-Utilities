# .env.example — copy to .env (committed defaults) or .env.local (per-machine, gitignored).
# Load order (later wins): built-in fallback < .env < .env.local < real environment variables.
# Bare KEY=VALUE lines, '#' comments. No python-dotenv needed (parsers are in-repo).
#
# packenv.py resolves EVERY path/id the tooling needs from the keys below (single source of truth).
# All keys are OPTIONAL — each falls back to the historical hardcoded value, so an empty .env
# reproduces today's paths exactly. Run `python3 packenv.py --check` to print what resolves on THIS
# machine (✓/✗ = exists). Only set a key to override for a machine move / renamed instance.

# --- roots (override for a non-default checkout / home layout) ---
# GITHUB_ROOT=/abs/path/to/Documents/GitHub          # holds the mod repos + the pack repo + hub
# HUB=/abs/path/to/Documents/GitHub/Mod-Sandbox      # memory/repos.json + release-manifest.json live here
# PACK_REPO=/abs/path/to/privates-minecraft-modpack
# PACK_DIR=/abs/path/to/privates-minecraft-modpack/MODPACKS/<Pack>   # the MODPACK dir (NOT the name)
# INSTANCES_ROOT=/abs/path/to/curseforge/minecraft/Instances
# INSTANCE_TEST=/abs/path/to/curseforge/Instances/<Pack> V1 TEST     # TEST client instance ROOT
# INSTANCE_SERVER=/abs/path/to/SERVERS/<Pack> V1 Server              # server instance ROOT
# PACK_PROJECT_ID=830694                              # CF modpack project id

# --- CurseForge instance root (mod_update_checker.py, etc.) ---
# INSTANCE_PATH is the historical alias for INSTANCE_TEST (the TEST client instance ROOT):
INSTANCE_PATH=/abs/path/to/curseforge/Instances/<Pack> V1 TEST

# --- config_sync.py: pack game-config sync (canonical <-> local instances) ---
# Pack display name (used for messages / built-in fallback path building):
PACK=<Pack display name>
# CANONICAL source of truth = the pack repo's src/common/config (what ships to players):
CANONICAL_CONFIG=/abs/path/to/privates-minecraft-modpack/MODPACKS/<Pack>/src/common/config
# Instances, by convention INSTANCE_<NAME>_CONFIG -> instance named <NAME>.
# Add as many as you like; each must point at the instance's `config` dir:
INSTANCE_TEST_CONFIG=/abs/path/to/curseforge/Instances/<Pack> V1 TEST/config
INSTANCE_SERVER_CONFIG=/abs/path/to/SERVERS/<Pack> V1 Server/config

# --- Secrets: PUT THESE IN .env.local ONLY (gitignored), NEVER in a committed .env ---
# CurseForge READ key (lookups; free at https://console.curseforge.com):
# CF_API_KEY=...
# CurseForge AUTHOR upload token (https://authors-old.curseforge.com/account/api-tokens):
# CF_UPLOAD_TOKEN=...
# Modrinth PAT (https://modrinth.com/settings/pats) — scopes: Create versions + Read user data.
# MODRINTH_TOKEN=...
